# Pooled connection for the Next.js app. Hostname contains -pooler.
# From the Neon console: Connect → pooled. Do not commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct connection for schema migrations and the psql client. No -pooler.
# The running app does not read this variable.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Managed Better Auth URL for this branch, including the /auth path.
# Example shape: https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://YOUR_ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth

# App secret for the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
# Neon does not inject this. Never prefix it with NEXT_PUBLIC_.
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32-chars

# Private Object Storage credential for the request-files bucket.
# Injected by `neon env pull` when neon.ts declares the bucket. Placeholders only.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL_S3=https://YOUR_ENDPOINT.storage.REGION.aws.neon.tech
AWS_REGION=ap-southeast-1

# Comma-separated browser origins allowed to PUT files. Used only by
# scripts/configure-storage-cors.mjs. Not read by the Next.js app.
STORAGE_CORS_ORIGINS=http://localhost:3000
