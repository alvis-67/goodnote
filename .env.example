# Public project URL, from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...). Safe to expose in the browser.
# A legacy anon key also works in this variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secret key (sb_secret_...). Server only. Bypasses RLS, so it is used only to
# check the allowlist before a session exists and to mint short-lived file URLs
# after a row-level check has already succeeded.
# A legacy service_role key also works here. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
